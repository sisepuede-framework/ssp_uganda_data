  <worksheets>
    <worksheet name='Agricultural Productivity'>
      <table>
        <view>
          <datasources>
            <datasource caption='drivers' name='federated.0t7ittm1g2vux11d2mwr00kq3xwc' />
          </datasources>
          <datasource-dependencies datasource='federated.0t7ittm1g2vux11d2mwr00kq3xwc'>
            <column caption='Year1' datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column caption='Category Value' datatype='string' name='[category_value]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;(&apos;freight&apos;, &apos;freight&apos;)&quot;' value='Freight' />
                <alias key='&quot;commercial_municipal&quot;' value='Commercial &amp; municipal' />
                <alias key='&quot;croplands&quot;' value='Croplands' />
                <alias key='&quot;forests_primary&quot;' value='Primary forests' />
                <alias key='&quot;forests_secondary&quot;' value='Secondary forests' />
                <alias key='&quot;fuel_coal&quot;' value='Coal' />
                <alias key='&quot;fuel_natural_gas&quot;' value='Natual gas' />
                <alias key='&quot;fuel_oil&quot;' value='Oil' />
                <alias key='&quot;grasslands&quot;' value='Grasslands &amp; pastrue lands' />
                <alias key='&quot;lime_and_carbonite&quot;' value='lime and carbonite' />
                <alias key='&quot;other&quot;' value='Other (including fallowed pastureland)' />
                <alias key='&quot;private_and_public&quot;' value='Private and public' />
                <alias key='&quot;rail_passenger&quot;' value='Rail (passenger)' />
                <alias key='&quot;regional&quot;' value='Regional' />
                <alias key='&quot;residential&quot;' value='Residential' />
                <alias key='&quot;road_heavy_regional&quot;' value='road_heavy_regional ??' />
                <alias key='&quot;rubber_and_leather&quot;' value='rubber and leather' />
                <alias key='&quot;wetlands&quot;' value='Wetlands' />
                <alias key='&quot;ww_domestic_rural&quot;' value='Rural' />
                <alias key='&quot;ww_domestic_urban&quot;' value='Urban' />
                <alias key='&quot;ww_industrial&quot;' value='Industrial' />
              </aliases>
            </column>
            <column caption='Model Variable' datatype='string' name='[model_variable]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Energy Demand by Fuel in Energy Technology&quot;' value='Energy Demand by Fuel in Power Generation' />
                <alias key='&quot;Energy Demand by Fuel in SCOE&quot;' value='Building energy demand by fuel' />
                <alias key='&quot;Fraction Non-Fugitive :math:\\text{CH}_4 Captured&quot;' value='Captured' />
                <alias key='&quot;Fraction Non-Fugitive :math:\\text{CH}_4 Flared&quot;' value='Flared' />
                <alias key='&quot;Livestock Manure Management Fraction Anaerobic Digester&quot;' value='Anaerobic Digester' />
                <alias key='&quot;Livestock Manure Management Fraction Anaerobic Lagoon&quot;' value='Anaerobic Lagoon' />
                <alias key='&quot;Livestock Manure Management Fraction Composting&quot;' value='Composting' />
                <alias key='&quot;Livestock Manure Management Fraction Daily Spread&quot;' value='Daily Spread' />
                <alias key='&quot;Livestock Manure Management Fraction Deep Bedding&quot;' value='Deep Bedding' />
                <alias key='&quot;Livestock Manure Management Fraction Dry Lot&quot;' value=' Dry Lot' />
                <alias key='&quot;Livestock Manure Management Fraction Incineration&quot;' value='Incineration' />
                <alias key='&quot;Livestock Manure Management Fraction Liquid Slurry&quot;' value='Liquid Slurry' />
                <alias key='&quot;Livestock Manure Management Fraction Paddock Pasture Range&quot;' value='Paddock Pasture Range' />
                <alias key='&quot;Livestock Manure Management Fraction Poultry Manure&quot;' value='Poultry Manure' />
                <alias key='&quot;Livestock Manure Management Fraction Solid Storage&quot;' value='Solid Storage' />
                <alias key='&quot;NemoMod Production by Technology&quot;' value='Electricity production by technology' />
              </aliases>
            </column>
            <column-instance column='[Year]' derivation='None' name='[none:Year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[category_value]' derivation='None' name='[none:category_value:nk]' pivot='key' type='nominal' />
            <column-instance column='[model_variable]' derivation='None' name='[none:model_variable:nk]' pivot='key' type='nominal' />
            <column-instance column='[strategy]' derivation='None' name='[none:strategy:nk]' pivot='key' type='nominal' />
            <column-instance column='[subsector]' derivation='None' name='[none:subsector:nk]' pivot='key' type='nominal' />
            <column-instance column='[variable]' derivation='None' name='[none:variable:nk]' pivot='key' type='nominal' />
            <column caption='Strategy' datatype='string' name='[strategy]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;HBLE&quot;' value='Candidate NDC3' />
                <alias key='&quot;NDC 2.0 (2020  Start) tuned manually&quot;' value='NDC 2.0 ' />
                <alias key='&quot;NDC 2.0 Unconditional based on cost effective measures from tornado&quot;' value='NDC2 Unconditional w/Additional Cost Effective&#10;' />
                <alias key='&quot;NDC 2.0 Unconditional based on Table 2-55 from NDC Technical Report (Zutari)&quot;' value='NDC2 Unconditional (As Planned)&#10;' />
                <alias key='&quot;NDC 2.0 with a 2025 start tuned manually&quot;' value='NDC 2.5' />
                <alias key='&quot;NDC 2.0 with a 2025 start tuned manually and buildings electrified at 50\%&quot;' value='NDC2 Conditional&#10;' />
                <alias key='&quot;Strategy TX:BASE&quot;' value='Business as usual' />
              </aliases>
            </column>
            <column caption='Subsector' datatype='string' name='[subsector]' role='dimension' type='nominal' />
            <column-instance column='[value]' derivation='Sum' name='[sum:value:qk]' pivot='key' type='quantitative' />
            <column caption='Value' datatype='real' name='[value]' role='measure' type='quantitative' />
            <column caption='Variable' datatype='string' name='[variable]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0t7ittm1g2vux11d2mwr00kq3xwc].[none:Year:qk]' included-values='in-range'>
            <min>1979</min>
            <max>2050</max>
          </filter>
          <filter class='categorical' column='[federated.0t7ittm1g2vux11d2mwr00kq3xwc].[none:category_value:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:category_value:nk]' member='&quot;bevs_and_spices&quot;' />
              <groupfilter function='member' level='[none:category_value:nk]' member='&quot;cereals&quot;' />
              <groupfilter function='member' level='[none:category_value:nk]' member='&quot;fibers&quot;' />
              <groupfilter function='member' level='[none:category_value:nk]' member='&quot;fruits&quot;' />
              <groupfilter function='member' level='[none:category_value:nk]' member='&quot;herbs_and_other_perennial_crops&quot;' />
              <groupfilter function='member' level='[none:category_value:nk]' member='&quot;nuts&quot;' />
              <groupfilter function='member' level='[none:category_value:nk]' member='&quot;other_annual&quot;' />
              <groupfilter function='member' level='[none:category_value:nk]' member='&quot;other_woody_perennial&quot;' />
              <groupfilter function='member' level='[none:category_value:nk]' member='&quot;pulses&quot;' />
              <groupfilter function='member' level='[none:category_value:nk]' member='&quot;rice&quot;' />
              <groupfilter function='member' level='[none:category_value:nk]' member='&quot;tubers&quot;' />
              <groupfilter function='member' level='[none:category_value:nk]' member='&quot;vegetables_and_vines&quot;' />
            </groupfilter>
          </filter>
          <computed-sort column='[federated.0t7ittm1g2vux11d2mwr00kq3xwc].[none:category_value:nk]' direction='DESC' using='[federated.0t7ittm1g2vux11d2mwr00kq3xwc].[sum:value:qk]' />
          <filter class='categorical' column='[federated.0t7ittm1g2vux11d2mwr00kq3xwc].[none:model_variable:nk]'>
            <groupfilter function='member' level='[none:model_variable:nk]' member='&quot;Crop Yield Factor&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0t7ittm1g2vux11d2mwr00kq3xwc].[none:strategy:nk]'>
            <groupfilter function='level-members' level='[none:strategy:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <manual-sort column='[federated.0t7ittm1g2vux11d2mwr00kq3xwc].[none:strategy:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Baseline NDP&quot;</bucket>
              <bucket>&quot;LNDU: Partial land use reallocation&quot;</bucket>
              <bucket>&quot;PFLO: Better baseline&quot;</bucket>
              <bucket>&quot;PFLO: Supply side technologies and transformations&quot;</bucket>
              <bucket>&quot;PFLO: All transformations without stopping deforestation and partial land use reallocation&quot;</bucket>
              <bucket>&quot;LNDU: Partial land use reallocation with India Climate Change&quot;</bucket>
              <bucket>&quot;LNDU: India CCDR&quot;</bucket>
              <bucket>&quot;PFLO: India CCDR and India Climate Change Impacts&quot;</bucket>
              <bucket>&quot;PFLO: All transformations with partial land use reallocation&quot;</bucket>
              <bucket>&quot;PFLO: All transformations with partial land use reallocation and India Climate Change Impacts&quot;</bucket>
              <bucket>&quot;Baseline&quot;</bucket>
              <bucket>&quot;Constrained Climate Action-Efficiency Only&quot;</bucket>
              <bucket>&quot;Unconstrained Climate Action -Technology Adoption Scenario-&quot;</bucket>
              <bucket>&quot;Strategy TX:BASE&quot;</bucket>
              <bucket>&quot;Constrained Climate Action&quot;</bucket>
              <bucket>&quot;Technology Adoption Scenario&quot;</bucket>
              <bucket>&quot;Unconstrained Climate Action&quot;</bucket>
              <bucket>&quot;Unconstrained Cliamte Action&quot;</bucket>
              <bucket>&quot;Net Zero&quot;</bucket>
              <bucket>&quot;WEM&quot;</bucket>
              <bucket>&quot;WAM&quot;</bucket>
              <bucket>&quot;BaU&quot;</bucket>
              <bucket>&quot;LEP&quot;</bucket>
              <bucket>&quot;BAU&quot;</bucket>
              <bucket>&quot;NDC&quot;</bucket>
              <bucket>&quot;All Actions&quot;</bucket>
              <bucket>&quot;NDC_2&quot;</bucket>
              <bucket>&quot;NZ&quot;</bucket>
              <bucket>&quot;NDC 2.0 Unconditional based on Table 2-55 from NDC Technical Report (Zutari)&quot;</bucket>
              <bucket>&quot;NDC 2.0 Unconditional based on cost effective measures from tornado&quot;</bucket>
              <bucket>&quot;NDC 2.0 with a 2025 start tuned manually&quot;</bucket>
              <bucket>&quot;NDC 2.0 (2020  Start) tuned manually&quot;</bucket>
              <bucket>&quot;NDC 2.0 with a 2025 start tuned manually and buildings electrified at 50\%&quot;</bucket>
              <bucket>&quot;HBLE&quot;</bucket>
            </dictionary>
          </manual-sort>
          <filter class='categorical' column='[federated.0t7ittm1g2vux11d2mwr00kq3xwc].[none:subsector:nk]'>
            <groupfilter function='member' level='[none:subsector:nk]' member='&quot;Agriculture&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0t7ittm1g2vux11d2mwr00kq3xwc].[none:variable:nk]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:variable:nk]' />
              <groupfilter function='member' level='[none:variable:nk]' member='%null%' />
            </groupfilter>
