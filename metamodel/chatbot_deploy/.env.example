# Copy this to .env for local dev — never commit .env
#
# On Railway (or any container host) set these as service environment variables.
# You need ONLY these four secrets — everything else has a default in config.py
# and the model + data are pulled from S3 at boot by scripts/download_assets.py.

ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Permanent, read-only IAM user keys (start with AKIA...). Do NOT use temporary /
# SSO credentials (ASIA... + session token) — they expire and will break the
# running service.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-west-2

# --- Local-dev only (leave unset on Railway) ---
# Use a named SSO profile instead of static keys when developing locally:
# AWS_PROFILE=alexa
#
# Defaults (override only if they change):
# S3_BUCKET=sisepuede-data
# S3_RUN_ID=sisepuede_run_2026-05-30T21:35:56.244639
